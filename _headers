# Never cache HTML/app metadata so deployments become visible immediately on reload.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/install
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/install/
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/install/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/minutes
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/minutes/
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/minutes/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/kpsc/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Always revalidate JS and CSS so browsers never serve stale assets after a deployment.
# Cloudflare will respond with 304 Not Modified (fast) if the file hasn't changed,
# or send the new file if it has — no manual cache-clearing needed by users.
/kpsc/*
  Cache-Control: no-cache, must-revalidate

/src/js/*
  Cache-Control: no-cache, must-revalidate

/src/css/*
  Cache-Control: no-cache, must-revalidate

/dist/js/*
  Cache-Control: no-cache, must-revalidate

/dist/css/*
  Cache-Control: no-cache, must-revalidate
