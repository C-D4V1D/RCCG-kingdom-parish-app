# Environment variables (API keys, secrets)
.env
.env.local
.env.*.local

# Node modules (if added later)
node_modules/
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Build output — note: dist/ IS committed because Cloudflare Pages serves it
# directly from the repo root. tests/build-output.test.js keeps it in sync
# with src/. Other build outputs stay ignored.
build/

# Wrangler local development state (dev-only SQLite caches)
.wrangler/

# Claude Code harness local state (agent worktrees, session caches)
.claude/

# Logs
*.log

# Local demo harness artefacts
scripts/demo/demo.sqlite*
scripts/demo/.shots/
